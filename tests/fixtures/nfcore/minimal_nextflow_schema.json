{
  "$id": "https://raw.githubusercontent.com/nf-core/demo/1.2.3/nextflow_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "allOf": [
    {
      "$ref": "#/definitions/input_output_options"
    },
    {
      "$ref": "#/definitions/reference_genome_options"
    },
    {
      "$ref": "#/definitions/advanced_options"
    }
  ],
  "definitions": {
    "advanced_options": {
      "description": "Advanced runtime options.",
      "properties": {
        "custom_selector": {
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "label"
              ]
            }
          ],
          "title": "Custom selector",
          "type": "object"
        },
        "max_cpus": {
          "default": 16,
          "minimum": 1,
          "title": "Max CPUs",
          "type": "integer"
        },
        "profile": {
          "default": "docker",
          "enum": [
            "docker",
            "singularity",
            "conda"
          ],
          "title": "Profile",
          "type": "string"
        }
      },
      "title": "Advanced options",
      "type": "object"
    },
    "input_output_options": {
      "description": "Define input samplesheet and output directory.",
      "properties": {
        "aligner": {
          "default": "star_salmon",
          "description": "Read aligner.",
          "enum": [
            "star_salmon",
            "hisat2"
          ],
          "title": "Aligner",
          "type": "string"
        },
        "input": {
          "description": "CSV samplesheet with sample,fastq_1,fastq_2 columns.",
          "exists": true,
          "format": "file-path",
          "mimetype": "text/csv",
          "pattern": "^\\S+\\.csv$",
          "schema": "assets/schema_input.json",
          "title": "Input samplesheet",
          "type": "string"
        },
        "outdir": {
          "default": "results",
          "description": "Directory for pipeline results.",
          "format": "directory-path",
          "title": "Output directory",
          "type": "string"
        }
      },
      "required": [
        "input",
        "outdir"
      ],
      "title": "Input/output options",
      "type": "object"
    },
    "reference_genome_options": {
      "description": "Reference files and indexes.",
      "properties": {
        "bed": {
          "exists": true,
          "format": "file-path",
          "title": "Target BED",
          "type": "string"
        },
        "bwa_index": {
          "title": "BWA index",
          "type": "string"
        },
        "fasta": {
          "exists": true,
          "format": "file-path",
          "title": "Genome FASTA",
          "type": "string"
        },
        "gtf": {
          "exists": true,
          "format": "file-path",
          "title": "Gene annotation GTF",
          "type": "string"
        },
        "igenomes_base": {
          "format": "directory-path",
          "title": "iGenomes base",
          "type": "string"
        },
        "star_index": {
          "title": "STAR index",
          "type": "string"
        }
      },
      "title": "Reference genome options",
      "type": "object"
    }
  },
  "dependentSchemas": {
    "profile": {
      "properties": {
        "container": {
          "type": "string"
        }
      }
    }
  },
  "description": "Demo nf-core RNA-seq pipeline used by Workbench schema mapper tests.",
  "git_sha": "abc123def456",
  "manifest": {
    "homePage": "https://github.com/nf-core/demo",
    "name": "nf-core/demo",
    "version": "1.2.3"
  },
  "title": "nf-core/demo pipeline parameters",
  "type": "object",
  "unexpected_root_construct": {
    "kept": true
  }
}
